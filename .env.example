# T:ROOT API — 실제 값은 .env 에 넣고 커밋하지 않는다
NODE_ENV=development
PORT=4000
API_PREFIX=api

# ── 도메인 / Cloudflare Tunnel ───────────────────────────────
ROOT_DOMAIN=tattooroot.com
API_DOMAIN=api.tattooroot.com
ADMIN_DOMAIN=admin.tattooroot.com
# 추가 허용 Origin (쉼표 구분)
CORS_ORIGINS=
# cloudflared 뒤에서 운영할 때 true → CF-Connecting-IP 를 실제 IP 로 사용
BEHIND_CLOUDFLARE=false
# Zero Trust > Networks > Tunnels 에서 발급
CLOUDFLARE_TUNNEL_TOKEN=

# ── DB (별도 서버 분리 가능) ─────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=troot
DB_PASSWORD=troot
DB_NAME=troot
# 매니지드 DB(원격) 사용 시 true
DB_SSL=false
DB_POOL_SIZE=10
DB_LOGGING=false

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=troot:
REDIS_MAXMEMORY=256mb
CACHE_TTL_MS=60000

# ── JWT (운영은 반드시 랜덤 값으로 교체) ─────────────────────
# 생성: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=30m
JWT_REFRESH_EXPIRES=30d

# ── 소셜 로그인 검증 ─────────────────────────────────────────
# 앱의 .env 와 동일한 클라이언트 ID (idToken audience 검증용)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
APPLE_BUNDLE_ID=com.troot.app

# ── 레이트리밋 ───────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ── Cloudflare R2 (이미지 업로드) ──────────────────────────
# 대시보드: R2 > 버킷 > Settings, R2 > Manage API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=troot
# 버킷 공개 도메인 (커스텀 도메인 권장 — 예: https://cdn.tattooroot.com)
R2_PUBLIC_BASE_URL=
R2_UPLOAD_TTL_SEC=300
